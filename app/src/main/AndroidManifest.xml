<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Necesario porque TmdbClient hace peticiones HTTP a api.themoviedb.org -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Fuerza un arranque en frío de Nuvio/Stremio antes de cada apertura
         (ver StremioLauncher.openWithFallback) — sin esto, a veces se
         quedan en la última ficha abierta en vez de navegar a la nueva. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- Para poder ofrecer instalar la APK de actualización descargada
         (UpdateChecker) sin pasar por Play Store. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Para poder avisar con una notificación de que la actualización ya
         se descargó y está lista para instalar (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para el "modo Fire TV" (ver FireTvCaptureService): captura de
         pantalla + OCR como alternativa cuando el AccessibilityService está
         bloqueado por la plataforma (comprobado que ocurre en Fire OS). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Para saber qué app está en primer plano (y no procesar OCR de
         pantallas de otras apps, solo del launcher) sin AccessibilityService.
         Es un permiso especial: no aparece como diálogo normal, hay que
         concederlo a mano en Ajustes → Acceso especial → Acceso a datos de
         uso (ver MainActivity/FireTvCaptureService). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Para activar el servicio de accesibilidad directamente por código en
         dispositivos donde "Restricted Settings" bloquea el toggle de
         Ajustes sin ninguna opción visible para desbloquearlo (p.ej. Google
         TV Streamer) — ver MainActivity.tryEnableAccessibilityDirectly.
         Igual que PACKAGE_USAGE_STATS, es un permiso especial: Android no
         lo concede nunca solo, hace falta `adb shell pm grant` una vez
         (documentado en el README). Sin ese permiso concedido, la app
         simplemente no lo tiene y cae al método normal (abrir Ajustes). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Para publicar nuestra propia fila de "Recomendado para ti" en la
         pantalla de inicio (ver RecommendationChannelManager) — el permiso
         que exige la API de canales de Android TV para poder escribir en
         ella, no aparece como diálogo normal (igual que otras apps con fila
         propia, p.ej. Wholphin/Plezy). Solo tiene efecto en Google TV: Fire
         OS no tiene este sistema de canales. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Sin esto, PackageManager.getPackageInfo() de cualquiera de estos
         paquetes puede devolver "no encontrado" aunque SÍ estén instalados
         — confirmado en dispositivo real con WuPlay (Android 11+ oculta la
         visibilidad de otras apps por defecto salvo que se declaren aquí).
         Necesario para StremioLauncher.isPackageInstalled (el aviso de
         "abrir en la Play Store" cuando la app de destino no está
         instalada) y para poder matar su proceso en segundo plano. -->
    <queries>
        <package android:name="com.nuvio.app" />
        <package android:name="com.nuvio.tv" />
        <package android:name="com.stremio.one" />
        <package android:name="com.plexapp.android" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="app.wuplay.androidtv" />
        <package android:name="com.github.damontecres.wholphin" />
        <package android:name="com.android.vending" />
    </queries>

    <!-- No hace falta mando táctil ni de verdad "leanback"; lo declaramos
         igualmente como no-requerido para que Google Play (si algún día se
         publica ahí) no descarte dispositivos TV. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/Theme.Leanback">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Sin esta categoría, la app queda instalada pero
                     invisible en la fila de apps del launcher de Android TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SubscriptionActivity" android:exported="false" />

        <activity android:name=".DeviceManagerActivity" android:exported="false" />

        <activity android:name=".HelpActivity" android:exported="false" />

        <activity
            android:name=".RecommendationsActivity"
            android:exported="false"
            android:theme="@style/Theme.Leanback" />

        <!-- Recibe el clic de un título de nuestra fila de "Recomendado
             para ti" en la pantalla de inicio (ver
             RecommendationChannelManager/RecommendationOpenActivity).
             exported=true porque quien lo lanza es el propio launcher del
             sistema, un proceso distinto — igual que MainActivity. -->
        <activity
            android:name=".RecommendationOpenActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:taskAffinity=""
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tvbridge" android:host="recommend" />
            </intent-filter>
        </activity>

        <!-- android:taskAffinity="" + excludeFromRecents en las tres de
             abajo: se lanzan con FLAG_ACTIVITY_NEW_TASK desde un Service o
             el AccessibilityService (obligatorio para arrancar una Activity
             fuera de una Activity), y sin una task affinity propia, Android
             las mete en la MISMA tarea que MainActivity si esa tarea ya
             existe (todas las Activities del paquete comparten la afinidad
             por defecto) — confirmado en dispositivo real: al pulsar Atrás,
             en vez de volver al launcher exactamente donde estaba, se
             quedaba dentro de nuestra propia app. Con su propia tarea
             aislada, Atrás revela de verdad lo que había en primer plano
             antes (el launcher, en su mismo sitio). -->
        <activity
            android:name=".MatchPickerActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <activity
            android:name=".WatchNowConfirmActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- Paywall contextual al pulsar una recomendación con la prueba
             gratuita ya terminada (ver TvRecommendationAccessibilityService/
             RecommendationOpenActivity/FireTvCaptureService). -->
        <activity
            android:name=".TrialExpiredActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- Diálogo de confirmación del modo Fire TV (ver
             FireTvCaptureService/ConfirmOpenActivity): necesita ser una
             Activity real (no un overlay) para poder recibir el pulso de OK
             genuino del mando. -->
        <activity
            android:name=".ConfirmOpenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Dialog"
            android:taskAffinity=""
            android:excludeFromRecents="true" />

        <!-- Recibe el aviso de DownloadManager cuando termina de bajar la
             APK de una actualización, para lanzar la notificación de
             "toca para instalar" (ver UpdateChecker/UpdateDownloadReceiver). -->
        <receiver
            android:name=".UpdateDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Expone la APK descargada (carpeta privada de la app) al
             instalador del sistema mediante un content:// URI, ya que un
             file:// directo está bloqueado desde Android 7. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".FireTvCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Red de seguridad opcional para búsqueda por voz en Google TV
             (ver VoiceSearchCaptureService/TvRecommendationAccessibilityService). -->
        <service
            android:name=".VoiceSearchCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <service
            android:name=".TvRecommendationAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice.config"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>

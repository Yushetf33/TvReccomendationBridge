<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TvRecommendationBridge" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color: el azul de acento de la interfaz (ver
             colors.xml) — controla, entre otras cosas, el color por
             defecto del cursor/subrayado de los EditText. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dim</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dim</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorAccent">@color/accent</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_root</item>
        <!-- Customize your theme here. -->
    </style>

    <!-- Tema para los pasos de Ajustes (ver MainMenuStepFragment y demás
         GuidedStepSupportFragment, devuelto desde su onProvideTheme) —
         mismo fondo/acento que el resto de la app en vez del gris por
         defecto de Leanback. -->
    <style name="Theme.TvRecommendationBridge.GuidedStep" parent="Theme.Leanback.GuidedStep">
        <item name="guidedStepBackground">@color/bg_root</item>
        <item name="guidedActionsBackground">@color/bg_root</item>
        <item name="guidedActionsBackgroundDark">@color/bg_root</item>
    </style>
</resources>